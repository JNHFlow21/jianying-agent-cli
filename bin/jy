#!/usr/bin/env python3
"""Executable entry point for the jy CLI."""

import os
import sys

# realpath so the entry works when invoked through a symlink (e.g. ~/.local/bin/jy)
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from jy_cli.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
